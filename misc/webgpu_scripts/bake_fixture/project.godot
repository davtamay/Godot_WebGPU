; Fixture project for the CI shader-bake gate.
;
; Exporting this project runs every RD shader the mobile renderer instantiates
; through the WebGPU shader container, which is where SPIR-V becomes WGSL. The
; export log then reports which variants could not be translated, and CI
; compares that census against expected-exclusions.txt. A new exclusion means
; upstream changed a shader into something WGSL cannot express.
;
; Keep the scene deterministic: the census is only meaningful if the set of
; instantiated shaders does not drift for reasons of our own.

config_version=5

[application]

config/name="WebGPU bake fixture"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8")

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.web="mobile"
rendering_device/driver.web="webgpu"
anti_aliasing/quality/msaa_3d=2
