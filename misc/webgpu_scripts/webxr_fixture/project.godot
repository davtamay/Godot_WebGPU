; Fixture project for the WebXR glue smoke test.
;
; Every headless drive injects at the XR tracker level, above the JS glue, so
; the glue itself only ever ran on a headset. glue-smoke.mjs boots this project
; inside IWER, an emulated WebXR runtime, so a real XRSession drives
; library_godot_webxr.js and webxr_interface_js.cpp.
;
; It uses the GL renderer because IWER has no XRGPUBinding: a pass here says
; nothing about the WebGPU binding or the Quest multiview path.

config_version=5

[application]

config/name="WebXR glue fixture"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"

[xr]

shaders/enabled=true
