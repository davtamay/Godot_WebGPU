config_version=5
[application]
config/name="WebGPU Rendering Coverage"
run/main_scene="res://main.tscn"
[display]
window/size/viewport_width=384
window/size/viewport_height=256
[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.web="forward_plus"
rendering_device/driver.web="webgpu"
textures/default_filters/use_nearest_mipmap_filter=false
